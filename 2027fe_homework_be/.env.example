# 复制为 .env 后再启动后端
APP_SECRET=tenzors-courseware-secret
APP_LANGUAGE=zh

APP_MYSQL_HOST=127.0.0.1
APP_MYSQL_PORT=3306
APP_MYSQL_NAME=be_exam
APP_MYSQL_USER=root
APP_MYSQL_PASS=123456

# 课件前端地址（Vite 默认 5173），带 Cookie 跨域必须写具体源，不能写 *
APP_ALLOW_ORIGINS=http://127.0.0.1:5173
APP_ALLOW_HEADERS=Origin|Content-Length|Content-Type|Authorization

APP_LOG_LEVEL=debug
APP_UPLOAD_DIR=./update
